# =========================================
# APP
# =========================================
APP_NAME=SIM Sekolah Terpadu
APP_ENV=development
APP_PORT=8080
APP_DEBUG=true

# =========================================
# SERVER
# =========================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# =========================================
# DATABASE - POSTGRESQL
# =========================================
DB_HOST=sim_sekolah_db
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=password123
DB_NAME=sim_sekolah_terpadu
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Jakarta

# PostgreSQL DSN (optional helper)
DATABASE_URL=postgres://admin:password123@sim_sekolah_db:5432/sim_sekolah_terpadu?sslmode=disable

# =========================================
# JWT AUTHENTICATION
# =========================================
JWT_SECRET=4f9d7c2b1a8e6f5d9c3b7e1a2f4c8d6e9b1f3a7c5d8e2f6a1b9c4d7e8f2a6c1
JWT_EXPIRE_HOUR=72

# =========================================
# BCRYPT
# =========================================
BCRYPT_COST=12

# =========================================
# RABBITMQ
# =========================================
RABBITMQ_HOST=sim_sekolah_broker
RABBITMQ_PORT=5672
RABBITMQ_USER=user
RABBITMQ_PASSWORD=password123

# =========================================
# NEO4J
# =========================================
NEO4J_URI=bolt://sim_sekolah_graph:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password123

# =========================================
# LOGGING
# =========================================
LOG_LEVEL=debug

# =========================================
# CORS
# =========================================
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:5174

# =========================================
# SWAGGER
# =========================================
SWAGGER_HOST=localhost:8080
# =========================================
# REDIS
# =========================================
REDIS_HOST=sim_sekolah_cache
REDIS_PORT=6379
REDIS_PASSWORD=password123
REDIS_DB=0

# =========================================
# RUSTFS
# =========================================
RUSTFS_URL=http://sim_sekolah_storage:9000
