# ============================================================================
# AI Platform Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control
# ============================================================================

# ----------------------------------------------------------------------------
# General Configuration
# ----------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# ----------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# ----------------------------------------------------------------------------
POSTGRES_DB=ai_platform
POSTGRES_USER=ai_user
POSTGRES_PASSWORD=ai_password
POSTGRES_PORT=5432

# Database URL (auto-constructed, but can be overridden)
# DATABASE_URL=postgresql://ai_user:ai_password@postgres:5432/ai_platform

# ----------------------------------------------------------------------------
# Cache Configuration (Redis)
# ----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Cache TTL settings
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=1000

# ----------------------------------------------------------------------------
# Message Queue Configuration (RabbitMQ)
# ----------------------------------------------------------------------------
RABBITMQ_URL=amqp://admin:admin@rabbitmq:5672
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin
RABBITMQ_MGMT_PORT=15672
RABBITMQ_VHOST=/

# ----------------------------------------------------------------------------
# Vector Database Configuration (Qdrant)
# ----------------------------------------------------------------------------
QDRANT_URL=http://qdrant:6333
QDRANT_HOST=qdrant
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=

# ----------------------------------------------------------------------------
# Object Storage Configuration (SeaweedFS)
# ----------------------------------------------------------------------------
SEAWEEDFS_MASTER=seaweedfs-master:9333
SEAWEEDFS_MASTER_PORT=9333
SEAWEEDFS_VOLUME_PORT=8080
SEAWEEDFS_FILER_PORT=8888
SEAWEEDFS_S3_PORT=8333
SEAWEEDFS_S3_ENDPOINT=http://seaweedfs-s3:8333
SEAWEEDFS_ACCESS_KEY=admin
SEAWEEDFS_SECRET_KEY=admin
SEAWEEDFS_SECURE=false
SEAWEEDFS_BUCKET=ai-platform-documents

# SeaweedFS buckets
SEAWEEDFS_BUCKET_DOCUMENTS=ai-platform-documents
SEAWEEDFS_BUCKET_IMAGES=ai-platform-images
SEAWEEDFS_BUCKET_MODELS=ai-platform-models
SEAWEEDFS_BUCKET_BACKUPS=ai-platform-backups

# ----------------------------------------------------------------------------
# Security Configuration
# ----------------------------------------------------------------------------
# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=7

# Encryption
ENCRYPTION_KEY=your-encryption-key-change-in-production-use-openssl-rand-hex-32

# Security headers
SECURITY_HEADERS_ENABLED=true
HTTPS_ENABLED=false
SSL_CERT_PATH=
SSL_KEY_PATH=

# CORS Configuration
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type,X-Requested-With

# ----------------------------------------------------------------------------
# Service Ports Configuration
# ----------------------------------------------------------------------------
GATEWAY_PORT=8002
PARSER_PORT=8001
SEMANTIC_CHUNK_PORT=8003
METADATA_PORT=8004
EMBEDDING_PORT=8005
RETRIEVAL_PORT=8006
GENERATION_PORT=8007
AUDIT_PORT=8008
MODERATION_PORT=8009
RERANKING_PORT=8010
VISION_PORT=8011
MONITORING_PORT=8012

# ----------------------------------------------------------------------------
# Observability Configuration
# ----------------------------------------------------------------------------
# Prometheus
PROMETHEUS_URL=http://prometheus:9090
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_URL=http://grafana:3000
GRAFANA_PORT=3030
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Loki (Log aggregation)
LOKI_URL=http://loki:3100
LOKI_PORT=3100

# Tempo (Distributed tracing)
TEMPO_URL=http://tempo:3200
TEMPO_PORT=3200
TEMPO_OTLP_GRPC_PORT=4317
TEMPO_OTLP_HTTP_PORT=4318

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
OTEL_SERVICE_NAME=ai-platform
OTEL_RESOURCE_ATTRIBUTES=environment=development

# Monitoring flags
METRICS_ENABLED=true
TRACING_ENABLED=true
LOGGING_ENABLED=true

# ----------------------------------------------------------------------------
# AI Provider Configuration
# ----------------------------------------------------------------------------
# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620

# ----------------------------------------------------------------------------
# Model Configuration
# ----------------------------------------------------------------------------
# Embedding Model
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cuda  # Options: cuda, cpu, mps
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DIMENSION=1024

# Generation Model
GENERATION_MODEL=meta-llama/Meta-Llama-3-8B-Instruct
GENERATION_TEMPERATURE=0.7
GENERATION_MAX_TOKENS=2048
GENERATION_TOP_P=0.9

# Vision Model
VISION_MODEL=google/paligemma-3b-mix-448

# OCR Configuration
TESSERACT_CMD=/usr/bin/tesseract
OCR_LANGUAGE=eng+ind

# ----------------------------------------------------------------------------
# Rate Limiting Configuration
# ----------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
RATE_LIMIT_PER_DAY=10000

# ----------------------------------------------------------------------------
# File Upload Configuration
# ----------------------------------------------------------------------------
MAX_FILE_SIZE=100MB
ALLOWED_FILE_TYPES=pdf,doc,docx,txt,png,jpg,jpeg,tiff,bmp
MAX_FILES_PER_UPLOAD=10

# ----------------------------------------------------------------------------
# Gateway Service Configuration
# ----------------------------------------------------------------------------
GATEWAY_HOST=0.0.0.0
GATEWAY_WORKERS=4
GATEWAY_TIMEOUT=30

# ----------------------------------------------------------------------------
# Parser Service Configuration
# ----------------------------------------------------------------------------
PARSER_TIMEOUT=300
PARSER_MAX_PAGES=100
PARSER_EXTRACT_IMAGES=true
PARSER_EXTRACT_TABLES=true

# ----------------------------------------------------------------------------
# Semantic Chunk Service Configuration
# ----------------------------------------------------------------------------
CHUNK_SIZE=512
CHUNK_OVERLAP=50
CHUNK_MIN_SIZE=100
CHUNK_STRATEGY=semantic  # Options: semantic, recursive, fixed

# ----------------------------------------------------------------------------
# Retrieval Service Configuration
# ----------------------------------------------------------------------------
RETRIEVAL_TOP_K=10
RETRIEVAL_MIN_SCORE=0.7
RETRIEVAL_HYBRID_SEARCH=true
RETRIEVAL_RERANK=true

# ----------------------------------------------------------------------------
# Generation Service Configuration
# ----------------------------------------------------------------------------
GENERATION_TIMEOUT=60
GENERATION_STREAM=true
GENERATION_INCLUDE_SOURCES=true

# ----------------------------------------------------------------------------
# Moderation Service Configuration
# ----------------------------------------------------------------------------
MODERATION_ENABLED=true
MODERATION_THRESHOLD=0.7
MODERATION_CATEGORIES=violence,sexual,hate,self-harm

# ----------------------------------------------------------------------------
# Audit Service Configuration
# ----------------------------------------------------------------------------
AUDIT_ENABLED=true
AUDIT_RETENTION_DAYS=90
AUDIT_ASYNC=true

# ----------------------------------------------------------------------------
# Vision Service Configuration
# ----------------------------------------------------------------------------
VISION_TIMEOUT=120
VISION_MAX_IMAGE_SIZE=10MB
VISION_SUPPORTED_FORMATS=png,jpg,jpeg,tiff,bmp,pdf

# ----------------------------------------------------------------------------
# RabbitMQ Consumer Configuration
# ----------------------------------------------------------------------------
ENABLE_RABBITMQ_CONSUMER=true
RABBITMQ_CONSUMER_PREFETCH_COUNT=10
RABBITMQ_CONSUMER_TIMEOUT=300

# ----------------------------------------------------------------------------
# Health Check Configuration
# ----------------------------------------------------------------------------
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_RETRIES=3

# ----------------------------------------------------------------------------
# Development Configuration
# ----------------------------------------------------------------------------
# Hot reload
PYTHONUNBUFFERED=1
RELOAD=true

# Debugging
PROFILING_ENABLED=false
DEBUGpy_ENABLED=false

# ----------------------------------------------------------------------------
# Feature Flags
# ----------------------------------------------------------------------------
FEATURE_RAG_ENABLED=true
FEATURE_VECTOR_SEARCH_ENABLED=true
FEATURE_HYBRID_SEARCH_ENABLED=true
FEATURE_RERANKING_ENABLED=true
FEATURE_MODERATION_ENABLED=true
FEATURE_AUDIT_ENABLED=true
FEATURE_OBSERVABILITY_ENABLED=true

# ----------------------------------------------------------------------------
# Third-party Integrations (Optional)
# ----------------------------------------------------------------------------
# Sentry for error tracking
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0

# DataDog for monitoring
DATADOG_API_KEY=
DATADOG_APP_KEY=
DATADOG_SITE=datadoghq.com