# Base OCR/Vision Image for AI Platform Services
# This image extends the base image with OCR and vision dependencies

FROM ai-platform-base:latest

LABEL maintainer="AI Platform Team"
LABEL description="Base OCR/Vision image for AI Platform services"

# Install OCR and vision system dependencies
RUN apt-get update && apt-get install -y \
    tesseract-ocr \
    tesseract-ocr-ind \
    tesseract-ocr-eng \
    tesseract-ocr-osd \
    libtesseract-dev \
    libleptonica-dev \
    pkg-config \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Install Python OCR and vision libraries
RUN pip install --no-cache-dir \
    pytesseract==0.3.13 \
    Pillow==10.4.0 \
    opencv-python-headless==4.10.0.84

# Set Tesseract path
ENV TESSERACT_CMD=/usr/bin/tesseract

# Set default command
CMD ["/bin/bash"]