# Base Python Image for AI Platform Services
# This image contains common dependencies for all services

FROM python:3.11-slim

LABEL maintainer="AI Platform Team"
LABEL description="Base Python image for AI Platform services"

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Install common system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Create app directory
WORKDIR /app

# Install uv for fast dependency management
RUN pip install --no-cache-dir uv

# Copy common requirements if they exist
# COPY requirements.base.txt /app/requirements.base.txt
# RUN uv pip install -r requirements.base.txt

# Set default command
CMD ["/bin/bash"]